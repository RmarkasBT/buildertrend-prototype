{
  "name": "buildertrend-mock",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client,agent -c blue,green,magenta \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:agent\"",
    "dev:server": "node --experimental-sqlite --env-file-if-exists=.env server/index.js",
    "dev:client": "vite",
    "dev:agent": "./.venv/bin/uvicorn agent.server:app --port 8001 --reload",
    "seed": "node --experimental-sqlite server/seed.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "mcp": "node server/mcp.js",
    "lint:openapi": "./.venv/bin/python scripts/check_openapi_drift.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0"
  }
}
